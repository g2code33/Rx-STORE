# RX Store — Frontend Environment
# Copy to .env.local and fill in (local overrides; .env.production holds the
# committed production value and is loaded automatically by production builds).

# Backend API base URL (no trailing slash).
# Cloudflare Workers: https://rx-store-api.calcitoninpay.workers.dev/v1
# Local dev: http://localhost:8787/v1
VITE_API_URL=

# Optional: Supabase / other overrides
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
